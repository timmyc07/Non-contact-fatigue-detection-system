{
  "build": {
    "beforeDevCommand": {
      "script": "flutter run -d web-server --web-port 1420 --web-hostname 127.0.0.1 --dart-define=NCFD_BACKEND_URL=http://127.0.0.1:5055",
      "cwd": "../flutter_app",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "flutter build web --release --no-web-resources-cdn --dart-define=NCFD_BACKEND_URL=http://127.0.0.1:5055",
      "cwd": "../flutter_app",
      "wait": true
    }
  },
  "app": {
    "macOSPrivateApi": true
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
